# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email notifications + pipeline alerts)
# Without NOTIFICATION_EMAIL — or with a dead RESEND_API_KEY — the pipeline runs
# blind: failures are logged and never reach anyone. Verify the key actually
# sends before trusting it (scripts/pipeline-doctor.ts reports send failures).
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=tu@email.com
# onboarding@resend.dev funciona sin verificar dominio, pero sólo entrega al
# email de la cuenta de Resend. Para enviar a cualquier dirección hay que
# verificar pymestools.com en resend.com/domains y poner noreply@pymestools.com.
RESEND_FROM=onboarding@resend.dev

# Vercel (for deploy polling from publish script)
VERCEL_TOKEN=...
VERCEL_PROJECT_ID=...
VERCEL_TEAM_ID=

# Google Search Console — service account (metrics ingest).
# Must be added in GSC → Settings → Users and permissions. Read-only access is
# enough for ingest; the Indexing API additionally requires Owner.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# IndexNow (Bing/Yandex)
INDEXNOW_KEY=...

# Site
NEXT_PUBLIC_SITE_URL=https://pymestools.com
